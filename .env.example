# Copy this file to ".env" for local testing (".env" is git-ignored, never commit it).
# On Railway, set the same names under the service's Variables tab instead.

# Where contact-form messages are delivered
CONTACT_EMAIL=you@example.com

# Resend (https://resend.com) - recommended
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Until your domain is verified in Resend, leave this as is. It only delivers to the
# email address your Resend account was created with.
RESEND_FROM=Setvion Website <onboarding@resend.dev>

# Optional fallbacks
# SETVION_EMAIL_PASSWORD=gmail-app-password
# MESSAGES_FILE=messages.csv
