# Copy this file to ".env" for local testing (".env" is git-ignored, never commit it).
# On Railway, set the same names under the service's Variables tab instead.

# Where contact-form messages are delivered
CONTACT_EMAIL=you@example.com

# Resend (https://resend.com) - recommended
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# IMPORTANT: with onboarding@resend.dev Resend only delivers to your own Resend account email,
# so the confirmation email to visitors will be refused. Verify your domain in Resend and use e.g.
# RESEND_FROM=Setvion <hello@yourdomain.com> to email anyone.
RESEND_FROM=Setvion Website <onboarding@resend.dev>

# Public address of your site, used for the logo and button inside emails (leave blank until live)
# SITE_URL=https://www.yourdomain.com

# Optional fallbacks
# SETVION_EMAIL_PASSWORD=gmail-app-password
# MESSAGES_FILE=messages.csv
